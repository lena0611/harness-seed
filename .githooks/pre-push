#!/usr/bin/env sh
set -eu

if [ -z "${NVM_DIR:-}" ]; then
  export NVM_DIR="$HOME/.nvm"
fi

if [ -s "$NVM_DIR/nvm.sh" ]; then
  # git hook은 로그인 셸의 nvm 상태를 물려받지 않을 수 있으므로 프로젝트 Node를 직접 적용한다.
  # nvm.sh와 nvm use는 set -u와 호환되지 않는다. dash(sh=dash인 Linux)에서는 미설정 변수
  # 참조가 expansion error라 `|| true`로도 잡히지 않고 hook 전체가 exit 2로 죽으므로 잠시 끈다.
  # npm이 주입한 prefix 환경변수는 nvm.sh가 경고 후 실패하므로 hook 안에서는 제거한다.
  unset npm_config_prefix NPM_CONFIG_PREFIX PREFIX || true
  set +u
  . "$NVM_DIR/nvm.sh"
  nvm use >/dev/null 2>&1 || true
  set -u
fi

# dual-runtime(0.2.63): 프로젝트 Node(.nvmrc)가 하네스 최소 버전(20.19) 미만이거나 node가 없으면
# 하네스 스크립트만 nvm 설치본 중 최신(>=20.19)으로 전환한다. 프로젝트 코드는 건드리지 않으며,
# 하네스는 프로젝트 lint/test/build를 실행하지 않는다(verify 제거, 0.2.131).
. .harness/bin/dual-node.sh
harness_dual_node_activate

# 낮은 Node에서 ESM 크래시 대신 업그레이드 안내가 나오도록 첫 node 호출 전에 버전을 검사한다.
node .harness/bin/check-node-version.mjs

# pre-push stdin(push ref 목록)은 한 번만 읽어 이전 훅에 그대로 재전달한다.
# 훅이 stdin을 소비해 버리면 뒤따르는 소비자가 빈 입력을 받는다(0.2.100).
# HARNESS_PUSH_STDIN 은 프로젝트 훅이 써도 되는 공식 인터페이스다 — 이름·뜻을 바꾸지 않는다(hook-coexistence.md).
# 끝 줄바꿈까지 그대로 둔다(0.2.156): $(...) 는 끝 줄바꿈을 지워서, git 견본처럼 `while read` 로 읽는 이전 훅이
# 마지막(대개 유일한) 줄을 못 읽고 push 목록을 빈 것으로 봤다. 끝에 표지(x)를 붙여 읽고 표지만 떼면 줄바꿈이 남는다.
harness_push_list="$(cat 2>/dev/null || true; printf x)"
harness_push_list="${harness_push_list%x}"
# 64KiB 이하일 때만 export 한다(0.2.156): 환경변수 하나가 Linux 에서 128KiB(MAX_ARG_STRLEN)를 넘으면 그 뒤 모든 실행
# (node 등)이 E2BIG 로 죽어 push 가 막힌다 — --mirror·처음 맞추는 원격처럼 ref 가 1,100개쯤이면 닿는다. 이전 훅에는 크기와
# 상관없이 표준 입력으로 그대로 넘긴다(printf 는 내장 명령이라 이 제한이 없다). 바깥에서 물려받은 같은 이름은 먼저 지운다 —
# 물려받은 변수는 대입해도 export 상태로 남는다.
unset HARNESS_PUSH_STDIN
if [ "$(printf '%s' "$harness_push_list" | wc -c | tr -d ' ')" -le 65536 ]; then
  HARNESS_PUSH_STDIN="$harness_push_list"
  export HARNESS_PUSH_STDIN
fi

# 기존 프로젝트 pre-push hook이 있으면 먼저 실행 (dual-runtime 전환 전의 PATH로 실행됨)
printf '%s' "$harness_push_list" | node .harness/bin/run-previous-hook.mjs pre-push "$@"

# P3(2026-06-09): npm/package.json 없는 비-Node 프로젝트에서도 동작하도록 npm 대신 harness 런처를 호출한다.
.harness/bin/harness check --fast


# 시드 모드 전용 원격 동기화 가드(비차단): GitHub/GitLab 같은 다중 원격이 어긋나지 않게 알림.
# .harness-seed-mode가 없는 소비자 프로젝트에서는 no-op. push를 막지 않는다.
node .harness/bin/check-remote-sync.mjs "$@" || true
